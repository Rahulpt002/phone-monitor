# Hotspot Monitor Server configuration. Every variable is optional unless marked REQUIRED.
#
# - Local development: copy to server/.env (the Server loads the first .env it finds in the
#   current directory, server/ or the repository root; real environment variables win).
# - VPS with Docker Compose: copy to deploy/.env (docker-compose.yml reads it).
# - Render: set these in the service's Environment tab (deploy/render.yaml lists them).
# Never commit the filled-in copy.

# --- Docker Compose only -----------------------------------------------------------------------
# Domain Caddy serves and gets a certificate for (DNS must point at the VPS).
DOMAIN=hsm.example.com

# --- network -----------------------------------------------------------------------------------
# Port and interface to listen on. Render sets PORT itself.
PORT=8080
HOST=0.0.0.0
# Public base URL of the Server (no trailing slash). Used in pairing deep links (QR code) and the
# ws_url given to the phone. If unset: RENDER_EXTERNAL_URL on Render, else derived from each
# request's X-Forwarded-Proto / Host. Set it when using a custom domain.
PUBLIC_URL=
# Trust X-Forwarded-* headers from proxies: true (any proxy; right for Render), false, or a comma
# list of trusted proxy addresses/ranges such as loopback,linklocal,uniquelocal (Docker + Caddy).
TRUST_PROXY=true
# Extra origins allowed to call the API from a browser (comma list), only needed when the
# Dashboard is hosted elsewhere, e.g. https://hsm-dashboard.vercel.app
CORS_ORIGINS=

# --- database ----------------------------------------------------------------------------------
# REQUIRED on Render (no persistent disk): the Turso database URL, e.g. libsql://hsm-yourname.turso.io
# Locally the default is file:<repo>/server/data/hsm.db; in Docker it is file:/data/hsm.db.
DATABASE_URL=
# REQUIRED with Turso: a database token from `turso db tokens create <db>`.
DATABASE_AUTH_TOKEN=

# --- first admin ------------------------------------------------------------------------------
# Used once, only while the users table is empty, to create the first admin. Password: at least
# 10 characters. After the first sign-in, enroll TOTP; then these can be removed.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# How long a Dashboard session lasts, in days.
SESSION_TTL_DAYS=30

# --- alerts: Telegram -------------------------------------------------------------------------
# Bot token from @BotFather and the chat id that receives alerts (see docs/deploy.md).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- alerts: Web Push -------------------------------------------------------------------------
# VAPID keys from `npx web-push generate-vapid-keys`. Leave both empty to have the Server generate
# a pair once and keep it in the database. Changing keys invalidates existing subscriptions.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services: mailto:you@example.com or an https URL (default: PUBLIC_URL).
VAPID_SUBJECT=

# --- misc -------------------------------------------------------------------------------------
# Built Dashboard to serve at / (default: <repo>/web/dist).
WEB_DIST=
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
